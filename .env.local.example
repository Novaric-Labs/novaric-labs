# Anthropic API key — powers the "Ask Novaric" chat widget and the
# "Is AI right for your workflow?" fit check. Used only in server-side
# route handlers (app/api/*), never exposed to the client.
ANTHROPIC_API_KEY=

# Optional: override the model used by the API routes.
# Defaults to claude-opus-5 if unset. Keep any override undated.
ANTHROPIC_MODEL=

# Optional: Formspree form ID for the contact form. If unset, the form
# falls back to a mailto: link to hello@novariclabs.com.
# Example value: xayzwxyz  (the part after https://formspree.io/f/)
NEXT_PUBLIC_FORMSPREE_ID=
